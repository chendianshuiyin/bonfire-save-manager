<Window x:Class="Bonfire.App.ModsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="篝火 · 简单 Mod 管理" Width="1100" Height="740" MinWidth="900" MinHeight="620" Background="#131820" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterOwner">
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="MOD / 游戏扩展" Foreground="#E9AC67" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="查看现有 Mod · 安装本地 ZIP · 按记录恢复原文件" Foreground="#9BA3B0" Margin="0,8,0,20"/></StackPanel>
  <Grid x:Name="Body" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,16"><DockPanel><Button DockPanel.Dock="Right" Content="重新扫描" Click="Refresh_Click" Margin="10,0,0,0"/><Button DockPanel.Dock="Right" Content="手动选择游戏目录" Click="Locate_Click" Margin="10,0,0,0"/><ComboBox x:Name="Installations" SelectionChanged="Installation_Changed"/></DockPanel><TextBlock x:Name="DirectoryText" Foreground="#9BA3B0" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
   <DataGrid Grid.Row="1" x:Name="ModList"><DataGrid.Columns><DataGridTextColumn Header="Mod" Binding="{Binding Name}" Width="190"/><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="155"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="210"/><DataGridTextColumn Header="识别依据 / 安装记录" Binding="{Binding Evidence}" Width="*"/></DataGrid.Columns></DataGrid>
   <StackPanel Grid.Row="2" Margin="0,16,0,0"><DockPanel Margin="0,0,0,12"><TextBlock DockPanel.Dock="Left" Text="名称" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="ModName" Width="300" DockPanel.Dock="Left" ToolTip="留空时使用 ZIP 文件名"/><TextBlock DockPanel.Dock="Left" Text="版本" VerticalAlignment="Center" Margin="16,0,10,0"/><TextBox x:Name="ModVersion" ToolTip="可填下载页标注的版本；未填写将显示未知"/></DockPanel><WrapPanel><Button Content="从 ZIP 安装" Background="#A86732" Click="Install_Click"/><Button Content="移除选中 Mod / 恢复原文件" Click="Remove_Click"/><Button Content="打开游戏目录" Click="Open_Click"/></WrapPanel><TextBlock Text="ZIP 必须按游戏目录布局打包；不会执行安装脚本。仅移除由篝火安装的 Mod；手工安装项只读识别。版本以文件声明或安装时填写为准。" Foreground="#9BA3B0" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"/></StackPanel>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#E9AC67" TextWrapping="Wrap" Margin="0,16,0,0"/>
 </Grid>
</Window>
